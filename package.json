{
  "name": "maria-castagno-gestion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "next build && node tests/e2e/run.mjs",
    "cotizaciones:probar": "tsx scripts/probar-fuentes.ts",
    "cotizaciones:historial": "tsx --env-file-if-exists=.env.local scripts/historial.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.0",
    "next": "16.4.6",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
